# Часовой пояс команды (сроки задач считаются в нём)
TZ=Europe/Moscow

# Порт, на котором слушает приложение
PORT=3000

# Публичный URL приложения (используется в ссылках внутри Telegram-уведомлений)
APP_URL=https://crm.pulsaura.ru

# На сервере обязательно production: включает https-куки и проверку секрета
NODE_ENV=production

# Секрет для подписи сессионной куки — 32+ случайных символа, без него сервер не стартует в production.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Необязательный внешний «замок»: общий логин/пароль браузера ДО страницы входа.
# Оставьте пустыми, чтобы выключить.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Данные администратора, создаваемого при первом запуске `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@team.local
SEED_ADMIN_PASSWORD=   # задайте сложный пароль (мин. 8 символов)

# Telegram-бот (получить токен у @BotFather). Без токена уведомления просто отключены,
# остальной сервис работает как обычно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Приём тёплых лидов от системы холодной рассылки (POST /api/outreach/events).
# Пусто = приём выключен. Длинный случайный токен, отдаётся разработчику рассылки лично.
OUTREACH_API_TOKEN=
# Необязательно: id пространства-воронки (по умолчанию «Холодные касания», создаётся само)
OUTREACH_SPACE_ID=
