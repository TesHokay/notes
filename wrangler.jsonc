{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsaura-crm",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "upload_source_maps": true,
  "build": {
    "command": "npm run cf:build"
  },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production",
    "TZ": "Europe/Moscow",
    "SEED_ADMIN_NAME": "Admin",
    "SEED_ADMIN_EMAIL": "admin@team.local"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM",
        "class_name": "CrmDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CrmDatabase"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pulsaura-crm-files"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
